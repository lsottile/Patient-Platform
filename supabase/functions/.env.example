# Secretos de las Edge Functions. En producción: `supabase secrets set --env-file supabase/functions/.env`
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Mercado Pago: nunca exponer estos valores en variables VITE_*.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# Cerrado por defecto. Solo `true` reactiva la creación de preapprovals.
COBROS_HABILITADOS=false
# Raíz pública exacta, incluida subruta y barra final (ej. GitHub Pages).
KINE_APP_URL=https://<usuario>.github.io/<repositorio>/
# Cadena aleatoria larga; debe coincidir con el secreto `secreto_cron` guardado en Vault.
SECRETO_CRON=
